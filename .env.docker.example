# Used by `docker compose build` to bake these into the frontend bundle
# (Vite env vars are compile-time, not runtime). Copy to .env at the repo
# root, alongside docker-compose.yml. backend/.env is separate — see
# backend/.env.example.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8080/api
