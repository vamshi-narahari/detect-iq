# AI provider — pick ONE path. If ANTHROPIC_API_KEY is set below, it takes
# priority over Bedrock automatically; leave it blank to use Bedrock instead.

# Option A: AWS Bedrock (no per-call cost surprises beyond your AWS billing/quotas)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Option B: Direct Anthropic API (no AWS account needed — get a key at
# https://console.anthropic.com). ANTHROPIC_MAX_DAILY_CALLS is a hard ceiling
# on AI calls per day for this server, since this path is pay-per-token with
# no natural spend limit otherwise. Still set a spend limit in the Anthropic
# Console too — this in-memory counter resets on server restart.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_DAILY_CALLS=50
# Only needed if your key is an "identity-linked" API key (the console will
# tell you via a 400 error mentioning anthropic-workspace-id if so). Find it
# in console.anthropic.com under your workspace's settings/URL. Leave blank
# for standard workspace API keys — most keys don't need this.
ANTHROPIC_WORKSPACE_ID=

# Supabase (service role — server-side only, never expose to frontend)
SUPABASE_URL=https://gckbdtcguptlfulzekzx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001
ALLOWED_ORIGINS=https://detect-iq.com

# Demo mode: caps AI generation calls per user per day on the public instance
DEMO_MODE=true
DEMO_DAILY_AI_LIMIT=2

# Optional: inbound webhook so Jira/Outlook/Teams/Webex automations can
# auto-create Intake tickets. Leave both blank to keep this endpoint fully
# disabled (safe default for the public demo instance). To find your user
# id, run in Supabase SQL editor: select id, email from auth.users;
INTAKE_WEBHOOK_SECRET=
INTAKE_OWNER_USER_ID=
